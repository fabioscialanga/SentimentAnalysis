pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    parameters {
        booleanParam(
            name: 'APPLY_K8S',
            defaultValue: false,
            description: 'Deploy su Kubernetes invece di Docker Compose'
        )
    }

    environment {
        COMPOSE_CMD = "docker compose"
    }

    stages {

        stage('Build') {
            steps {
                echo "Build con Docker Compose"
                sh "${COMPOSE_CMD} build sentiment-api"
            }
        }

        stage('Test') {
            steps {
                echo "Esecuzione test"
                sh """
                cd api
                python -m pip install --upgrade pip
                pip install -r requirements.txt
                pip install pytest
                pytest tests/ -v
                """
            }
        }

        stage('Deploy') {
            steps {
                script {
                    if (params.APPLY_K8S) {
                        echo "Deploy su Kubernetes"
                        sh "kubectl apply -f k8s/sentiment-stack.yaml"
                    } else {
                        echo "Deploy con Docker Compose"
                        sh "${COMPOSE_CMD} up -d sentiment-api"
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completata con successo'
        }
        failure {
            echo 'Pipeline fallita'
        }
    }
}
